<?xml version="1.0" ?>
<!--
  Same 3.00 x 2.40 m room as empty_room.sdf, plus the minimum furniture needed
  for loop closure to actually mean something.

  Why the pillar exists
  ---------------------
  Loop closure corrects drift accumulated while a place was out of view. In a
  bare rectangle every wall is visible from everywhere, so no drift accumulates
  and slam_toolbox never has anything to close. The centre pillar occludes:
  driving a lap around it hides part of the room, lets pose error build, and
  makes the return to the start a genuine loop closure event you can watch fire.

  Why the two corner blocks exist
  -------------------------------
  A bare rectangle is 180-degree symmetric, so scan matching cannot distinguish
  the room from itself rotated a half turn. Two blocks of different size in
  non-opposite corners break that symmetry.

  Obstacle heights are deliberate. The VLP-16 sits at 1.05 m and its lowest beam
  is 15 degrees down, so at horizontal distance d it passes 1.05 - 0.268*d above
  the floor - about 0.65 m at 1.5 m range. Anything shorter than that nearby is
  invisible to the sensor. Everything here is 1.1 m or taller so it is seen from
  anywhere in the room.

  Lap for testing:  start at (-1.0, 0) -> +x along y<0 -> +y end -> -x along
  y>0 -> back to start. That is one full circuit of the pillar.
-->
<sdf version="1.9">
  <world name="tetra_loop_room">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.80 0.86 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.58 1</ambient>
            <diffuse>0.65 0.65 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room">
      <static>true</static>
      <link name="walls">

        <collision name="wall_xpos_collision">
          <pose>1.55 0 1.0 0 0 0</pose>
          <geometry><box><size>0.1 2.6 2.0</size></box></geometry>
        </collision>
        <visual name="wall_xpos_visual">
          <pose>1.55 0 1.0 0 0 0</pose>
          <geometry><box><size>0.1 2.6 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>

        <collision name="wall_xneg_collision">
          <pose>-1.55 0 1.0 0 0 0</pose>
          <geometry><box><size>0.1 2.6 2.0</size></box></geometry>
        </collision>
        <visual name="wall_xneg_visual">
          <pose>-1.55 0 1.0 0 0 0</pose>
          <geometry><box><size>0.1 2.6 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>

        <collision name="wall_ypos_collision">
          <pose>0 1.25 1.0 0 0 0</pose>
          <geometry><box><size>3.2 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="wall_ypos_visual">
          <pose>0 1.25 1.0 0 0 0</pose>
          <geometry><box><size>3.2 0.1 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>

        <collision name="wall_yneg_collision">
          <pose>0 -1.25 1.0 0 0 0</pose>
          <geometry><box><size>3.2 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="wall_yneg_visual">
          <pose>0 -1.25 1.0 0 0 0</pose>
          <geometry><box><size>3.2 0.1 2.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
        </visual>

      </link>
    </model>

    <!-- Centre pillar. 0.30 m square leaves a 1.05 m gap to the long walls and
         1.35 m to the short ones - comfortable for a 0.43 m wide robot to lap
         under teleop. -->
    <model name="centre_pillar">
      <static>true</static>
      <pose>0 0 0.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.30 0.30 1.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 0.30 1.6</size></box></geometry>
          <material><ambient>0.35 0.30 0.28 1</ambient><diffuse>0.45 0.38 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Asymmetry breakers: different sizes, non-opposite corners. -->
    <model name="corner_block_a">
      <static>true</static>
      <pose>-1.30 1.00 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.35 0.25 1.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.25 1.3</size></box></geometry>
          <material><ambient>0.20 0.35 0.45 1</ambient><diffuse>0.25 0.45 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="corner_block_b">
      <static>true</static>
      <pose>1.35 -0.95 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 0.45 1.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.45 1.1</size></box></geometry>
          <material><ambient>0.45 0.35 0.18 1</ambient><diffuse>0.58 0.45 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
